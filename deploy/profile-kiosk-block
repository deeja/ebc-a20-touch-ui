# >>> ebc-kiosk >>>
# Managed by deploy/install.sh - do not edit by hand, re-run install.sh instead.
# Only auto-starts X on the tty1 console login, never over SSH, so SSH access
# for maintenance/debugging keeps working normally.
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
  while true; do
    startx -- -nocursor
    sleep 2
  done
fi
