# Copy this file to `config` (gitignored - it holds a password) and fill in
# FIRST_USER_PASS before running deploy/pi-gen/build.sh.

IMG_NAME="battery-tester-kiosk"
TARGET_HOSTNAME="battery-tester"

FIRST_USER_NAME="kiosk"
FIRST_USER_PASS="changeme"
DISABLE_FIRST_BOOT_USER_RENAME=1

ENABLE_SSH=1

# Lite base (stage0-stage2) plus our custom kiosk stage - no desktop stages.
STAGE_LIST="stage0 stage1 stage2 stage-kiosk"
